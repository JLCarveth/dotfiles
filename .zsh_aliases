alias ff="clear && fastfetch -c examples/13"
alias ll="ls -lah --color=always"
alias vim=nvim
alias g=git

alias bat="batcat --theme=\"Catppuccin Latte\""

alias pbcopy='xclip -r -selection clipboard'
alias pbpaste='xclip -selection clipboard -o'
alias pbedit='pbpaste > /tmp/clipboard-edit.txt && $EDITOR /tmp/clipboard-edit.txt && cat /tmp/clipboard-edit.txt | pbcopy && rm /tmp/clipboard-edit.txt'

alias t2="tree -C -L 2 -I \"node_modules/\" | less"
alias t3="tree -C -L 3 -I \"node_modules/\""

alias rg="rg -L --no-ignore-vcs"

alias -g ...='../..'
alias -g ....='../../..'
alias -g .....='../../../..'
alias -g ......='../../../../..'

alias -- -='cd -'
alias 1='cd -1'
alias 2='cd -2'
alias 3='cd -3'
alias 4='cd -4'
alias 5='cd -5'
alias 6='cd -6'
alias 7='cd -7'
alias 8='cd -8'
alias 9='cd -9'
